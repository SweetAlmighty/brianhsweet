# Normalize line endings to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.{cmd,bat} text eol=crlf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated lock files: collapse in diffs.
package-lock.json linguist-generated=true -diff
